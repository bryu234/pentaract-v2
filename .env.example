PENTARACT_HTTP_PORT=8088
PENTARACT_DATA_DIR=/data
PENTARACT_SHARED_DIR=/shared
PENTARACT_MASTER_KEY_FILE=/run/pentaract-secrets/master.key
PENTARACT_COOKIE_SECURE=false
PENTARACT_PUBLIC_URL=http://localhost:8088
PENTARACT_DOMAIN=storage.example.com
PENTARACT_TELEGRAM_API_URL=http://telegram-bot-api:8081
PENTARACT_TRASH_RETENTION_DAYS=30
PENTARACT_TELEGRAM_CHUNK_MIB=256

POSTGRES_USER=pentaract
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pentaract

# Obtain these at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
